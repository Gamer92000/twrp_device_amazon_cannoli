DEVICE_PATH := device/amazon/cannoli

TARGET_ARCH := arm
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := armeabi-v7a
TARGET_CPU_ABI2 := armeabi
TARGET_CPU_VARIANT := cortex-a53

TARGET_BOARD_PLATFORM := mt8519
TARGET_BOOTLOADER_BOARD_NAME := mt8519
TARGET_NO_BOOTLOADER := true
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilts/zImage

BOARD_KERNEL_BASE := 0x40078000
BOARD_KERNEL_PAGESIZE := 4096
BOARD_FLASH_BLOCK_SIZE := 262144
BOARD_BOOTIMAGE_PARTITION_SIZE := 13676544
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 13676544

RECOVERY_VARIANT := twrp
BOARD_BUILD_SYSTEM_ROOT_IMAGE := true
TARGET_USERIMAGES_USE_EXT4 := false
TARGET_RECOVERY_DEVICE_DIRS := $(DEVICE_PATH)
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery/root/etc/recovery.fstab

TW_THEME := portrait_mdpi
TW_EXCLUDE_TWRPAPP := true
TW_EXCLUDE_SUPERSU := true
TW_INCLUDE_BCBTOOL := true
TW_NO_LEGACY_PROPS := true
TW_INCLUDE_CRYPTO := false

ALLOW_MISSING_DEPENDENCIES := true
